FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat

FROM base AS pruner
COPY . .
RUN npm i -g turbo@2.5.5 && turbo prune @jersey-commerce/api --docker

FROM base AS deps
COPY --from=pruner /app/out/json/ .
RUN npm ci

FROM deps AS build
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./
RUN npm run build -w @jersey-commerce/types -w @jersey-commerce/validation -w @jersey-commerce/config -w @jersey-commerce/utils
RUN npm run prisma:generate -w @jersey-commerce/api
RUN npm run build -w @jersey-commerce/api
RUN npm prune --omit=dev

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/apps/api/generated ./apps/api/generated
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/packages ./packages
COPY infra/docker/api-entrypoint.sh /api-entrypoint.sh
RUN chmod +x /api-entrypoint.sh \
  && mkdir -p /app/apps/api/uploads
WORKDIR /app/apps/api
EXPOSE 4000
ENTRYPOINT ["/api-entrypoint.sh"]
