# Hybrid production env for the API VM.
# Copy to infra/docker/.env.production on the VM (never commit real secrets).
#
# Standalone (own Caddy on :443): use docker-compose.api.yml + prod-up.sh
# Cohost with Cullinos nginx:     use + docker-compose.cohost.yml + prod-up-cohost.sh
#                                 (API on 127.0.0.1:4000; see COHOST-CUTOVER.md)

# Public IPv4 (no http://)
PUBLIC_IP=REPLACE_WITH_VULTR_IP

# Hostname for the API (DNS A/AAAA must point at PUBLIC_IP).
# Standalone: Caddy uses this for HTTPS. Cohost: nginx server_name + certbot.
API_HOST=api.example.com

# Let's Encrypt registration email
ACME_EMAIL=you@example.com

# Comma-separated browser origins allowed to call the API (no trailing slashes).
# Include Vercel storefront + admin URLs and the Jersey Staff EXE origin.
# Example:
# CORS_ORIGINS=https://shop.vercel.app,https://admin.vercel.app,http://127.0.0.1:39217,http://localhost:3000,http://localhost:3001
CORS_ORIGINS=https://REPLACE_STOREFRONT_ORIGIN,https://REPLACE_ADMIN_ORIGIN,http://127.0.0.1:39217

# Optional: platform apex for {slug}.domain tenant resolution on the storefront
# PLATFORM_DOMAIN=yourshop.com

COOKIE_SECURE=true
COOKIE_SAMESITE=none

# PostgreSQL — letters/numbers only so DATABASE_URL stays valid
POSTGRES_USER=jersey
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=jersey_commerce

# Default tenant slug (also used by Vercel storefront env)
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-jersey-store

# JWT secrets — each must be at least 32 characters
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32ch

# Required to create the first shop + owner: POST /api/v1/admin/tenants
BOOTSTRAP_SECRET=replace-with-a-long-bootstrap-secret

# Encrypts per-tenant Resend / MSG91 / Google secrets stored from Admin.
SECRETS_ENCRYPTION_KEY=replace-with-a-long-random-secrets-key-32chars

# Razorpay Standard Checkout (server only). Prefer Admin → Settings → Payments.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# Required for reliable online payments. In the Razorpay dashboard add a webhook to
#   https://<API_HOST>/api/v1/webhooks/razorpay
# with events payment.captured, payment.failed, order.paid, refund.processed and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=replace-with-the-razorpay-webhook-secret

# Unpaid online orders release their reserved stock after this many minutes (minimum 15).
ORDER_PAYMENT_TTL_MINUTES=60
# Set to false to pause the expiry job (e.g. during a Razorpay outage).
# ORDER_EXPIRY_ENABLED=true

# Backups are written to the api_backups Docker volume mounted at /backups, then uploaded to
# Cloudflare R2 when R2_* below is set. In Admin → Settings → Backup set the folder to /backups.
# Restore: download from R2 (optional) → decrypt if needed → empty DB:
#   npm run backup:decrypt -w @jersey-commerce/api -- <file.json.gz.enc>
#   npm run backup:restore -w @jersey-commerce/api -- <file> --confirm

# The API sits behind Caddy/nginx, so it trusts X-Forwarded-For from the first proxy hop
# (set in docker-compose). Never expose port 4000 directly to the internet with this on,
# or clients could spoof their IP and bypass rate limits.

LOG_LEVEL=info

# The API refuses to boot in production if the JWT secrets above are missing, shorter than
# 32 characters, still contain "replace-with" / "change-me", or are identical.
# Generate with: openssl rand -base64 48

# 32+ characters. Backups are AES-256-GCM encrypted (.json.gz.enc); in production backups
# fail without it. Store a copy offline — backups cannot be restored without this key.
# Decrypt with: npm run backup:decrypt -w @jersey-commerce/api -- <file.json.gz.enc>
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-key-32chars

# Cloudflare R2 offsite backup copies (recommended in production).
# 1. Cloudflare dashboard → R2 → Create bucket (e.g. jerzyfy-backups), keep private.
# 2. Manage R2 API Tokens → Create API token with Object Read & Write on that bucket.
# 3. Paste Account ID, Access Key ID, Secret Access Key below. Leave R2_ENDPOINT empty
#    unless you need a custom endpoint (default is https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
# After deploy: Admin → Settings → Backup → enable daily, path /backups, Run backup now;
# confirm a SUCCESS run and an object under backups/<tenant-slug>/ in the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=jerzyfy-backups
# R2_ENDPOINT=

# 32+ characters. Set the SAME value on the Vercel storefront project so per-shopper rate
# limits use the real client IP instead of Vercel's shared egress IPs.
STOREFRONT_PROXY_SECRET=replace-with-a-long-random-proxy-secret-32ch

# Optional error monitoring. Leave empty to disable.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Vercel projects (set there, not on this VM):
#   Storefront: NEXT_PUBLIC_STOREFRONT_URL=https://shop.example.com  (canonical URL for sitemap/robots/OG tags)
#               STOREFRONT_PROXY_SECRET=<same as above>, NEXT_PUBLIC_SENTRY_DSN, SENTRY_DSN
#   Admin/POS:  NEXT_PUBLIC_SENTRY_DSN (browser error reporting)
#               NEXT_PUBLIC_STAFF_REFRESH_COOKIE_ONLY=true only when Admin/POS and the API share a site
#               (e.g. admin.example.com + api.example.com); keeps the refresh token out of localStorage.
