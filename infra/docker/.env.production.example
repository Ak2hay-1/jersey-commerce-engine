# Hybrid production env for the API VM.
# Copy to infra/docker/.env.production on the VM (never commit real secrets).
#
# Standalone (own Caddy on :443): use docker-compose.api.yml + prod-up.sh
# Cohost with Cullinos nginx:     use + docker-compose.cohost.yml + prod-up-cohost.sh
#                                 (API on 127.0.0.1:4000; see COHOST-CUTOVER.md)

# Public IPv4 (no http://)
PUBLIC_IP=REPLACE_WITH_VULTR_IP

# Hostname for the API (DNS A/AAAA must point at PUBLIC_IP).
# Standalone: Caddy uses this for HTTPS. Cohost: nginx server_name + certbot.
API_HOST=api.example.com

# Let's Encrypt registration email
ACME_EMAIL=you@example.com

# Comma-separated browser origins allowed to call the API (no trailing slashes).
# Include Vercel storefront + admin URLs and the Jersey Staff EXE origin.
# Example:
# CORS_ORIGINS=https://shop.vercel.app,https://admin.vercel.app,http://127.0.0.1:39217,http://localhost:3000,http://localhost:3001
CORS_ORIGINS=https://REPLACE_STOREFRONT_ORIGIN,https://REPLACE_ADMIN_ORIGIN,http://127.0.0.1:39217

# Optional: platform apex for {slug}.domain tenant resolution on the storefront
# PLATFORM_DOMAIN=yourshop.com

COOKIE_SECURE=true
COOKIE_SAMESITE=none

# PostgreSQL — letters/numbers only so DATABASE_URL stays valid
POSTGRES_USER=jersey
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=jersey_commerce

# Default tenant slug (also used by Vercel storefront env)
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-jersey-store

# JWT secrets — each must be at least 32 characters
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32ch

# Required to create the first shop + owner: POST /api/v1/admin/tenants
BOOTSTRAP_SECRET=replace-with-a-long-bootstrap-secret

# Encrypts per-tenant Resend / MSG91 / Google secrets stored from Admin.
SECRETS_ENCRYPTION_KEY=replace-with-a-long-random-secrets-key-32chars

# Razorpay Standard Checkout (server only). Prefer Admin → Settings → Payments.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx

LOG_LEVEL=info
