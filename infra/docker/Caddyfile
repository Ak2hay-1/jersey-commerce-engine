# TLS terminator for the Nest API (hybrid production).
# Set API_HOST and ACME_EMAIL in .env.production (compose passes them into the container).
# DNS A/AAAA for API_HOST must point at this VM before first start.

{
	email {$ACME_EMAIL}
}

{$API_HOST} {
	encode gzip

	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
	}

	# Per-file limits are enforced by the API; custom-order inquiries carry up to 5 x 8 MB.
	@inquiry path /api/v1/store/custom-orders/inquiry
	request_body @inquiry {
		max_size 45MB
	}
	@other not path /api/v1/store/custom-orders/inquiry
	request_body @other {
		max_size 10MB
	}

	reverse_proxy api:4000
}
