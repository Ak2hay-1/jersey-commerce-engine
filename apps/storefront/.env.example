NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-jersey-store
NEXT_PUBLIC_SINGLE_TENANT=true
# Optional public Razorpay key (KEY_ID only). Prefer key from store bootstrap payments.razorpayKeyId.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Optional. Server-only. In Docker set to http://api:4000 so SSR skips the public IP.
# API_INTERNAL_URL=http://api:4000
# Public storefront URL used for canonical links, robots.txt and sitemap.xml.
# NEXT_PUBLIC_STOREFRONT_URL=https://www.jerzyfy.in
# Admin origins allowed to frame the storefront (website customizer preview). Comma-separated.
# NEXT_PUBLIC_ADMIN_URL=https://admin.jerzyfy.in
# NEXT_PUBLIC_CUSTOMIZER_PARENT_ORIGINS=https://admin.jerzyfy.in
# Set to true to send Content-Security-Policy as Report-Only while validating a new policy.
# CSP_REPORT_ONLY=false
# Server-only, 32+ characters. Must equal the API's STOREFRONT_PROXY_SECRET.
# STOREFRONT_PROXY_SECRET=
# Grievance officer shown on /grievance and /privacy (IT Rules 2021 / DPDP Act).
# NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
# NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
# Optional error monitoring (browser + server). Leave unset to disable.
# NEXT_PUBLIC_SENTRY_DSN=
