NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-jersey-store
NEXT_PUBLIC_SINGLE_TENANT=true
# Optional public Razorpay key (KEY_ID only). Prefer key from store bootstrap payments.razorpayKeyId.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Optional. Server-only. In Docker set to http://api:4000 so SSR skips the public IP.
# API_INTERNAL_URL=http://api:4000
