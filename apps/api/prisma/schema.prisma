  design      CustomOrderDesign @relation(fields: [designId], references: [id], onDelete: Restrict)
  decidedByUser     User?     @relation("CustomOrderDesignApprover", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByCustomer Customer? @relation(fields: [decidedByCustomerId], references: [id], onDelete: SetNull)

