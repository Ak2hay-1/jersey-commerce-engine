  createdAt     DateTime                    @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("CustomOrderProductionActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, customOrderId, createdAt])
  @@map("custom_order_production_events")
}

/// Prepared for Phase 14 messaging. This phase records events; it does not send WhatsApp or email.
model CustomOrderCommunicationEvent {
  id            String                         @id @default(cuid())
  tenantId      String                         @map("tenant_id")
  customOrderId String                         @map("custom_order_id")
  type          CustomOrderCommunicationType
  status        CustomOrderCommunicationStatus @default(PENDING)
  payload       Json?
  createdAt     DateTime                       @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, customOrderId, createdAt])
  @@index([tenantId, type, status])
  @@map("custom_order_communication_events")
}
