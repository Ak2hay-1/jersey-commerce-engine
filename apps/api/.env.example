# Copy to .env in this directory or use the repository root .env.
# Never commit real secrets.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://jersey:jersey@localhost:5432/jersey_commerce?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
LOG_LEVEL=info
# Optional. When set, automatic backups may only be written inside this folder.
# BACKUP_ALLOWED_ROOT=C:\Backups

# Auth / JWT — replace these placeholders locally. Never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32ch
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BOOTSTRAP_SECRET=
TRUST_PROXY=false
# Optional. When set, {slug}.{domain} resolves a storefront tenant.
# PLATFORM_DOMAIN=platform.com
