NEXT_PUBLIC_API_URL=http://localhost:4000
# admin = website CMS + promo codes (VM). erp = inventory/sales (local PC). all = both (local development).
NEXT_PUBLIC_PORTAL=all
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-jersey-store
NEXT_PUBLIC_SINGLE_TENANT=true
# Optional browser error reporting.
# NEXT_PUBLIC_SENTRY_DSN=
# true only when Admin and the API share a site (e.g. admin.example.com + api.example.com):
# the refresh token then lives only in the API's HttpOnly cookie, never in localStorage.
# NEXT_PUBLIC_STAFF_REFRESH_COOKIE_ONLY=false
