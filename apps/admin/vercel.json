{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix=../..",
  "buildCommand": "cd ../.. && node infra/vercel/build-admin.mjs",
  "outputDirectory": "out",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src 'self' https:; media-src 'self' blob: https:; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sales/:id", "destination": "/sales/[id]/index.html" },
    { "source": "/sales/:id/", "destination": "/sales/[id]/index.html" },
    { "source": "/orders/:id", "destination": "/orders/[id]/index.html" },
    { "source": "/orders/:id/", "destination": "/orders/[id]/index.html" },
    { "source": "/products/:id", "destination": "/products/[id]/index.html" },
    { "source": "/products/:id/", "destination": "/products/[id]/index.html" },
    { "source": "/categories/:id", "destination": "/categories/[id]/index.html" },
    { "source": "/categories/:id/", "destination": "/categories/[id]/index.html" },
    { "source": "/purchases/:id", "destination": "/purchases/[id]/index.html" },
    { "source": "/purchases/:id/", "destination": "/purchases/[id]/index.html" },
    { "source": "/suppliers/:id", "destination": "/suppliers/[id]/index.html" },
    { "source": "/suppliers/:id/", "destination": "/suppliers/[id]/index.html" },
    { "source": "/customers/:id", "destination": "/customers/[id]/index.html" },
    { "source": "/customers/:id/", "destination": "/customers/[id]/index.html" },
    { "source": "/expenses/:id", "destination": "/expenses/[id]/index.html" },
    { "source": "/expenses/:id/", "destination": "/expenses/[id]/index.html" },
    { "source": "/custom-orders/:id", "destination": "/custom-orders/[id]/index.html" },
    { "source": "/custom-orders/:id/", "destination": "/custom-orders/[id]/index.html" },
    { "source": "/inventory/:variantId", "destination": "/inventory/[variantId]/index.html" },
    { "source": "/inventory/:variantId/", "destination": "/inventory/[variantId]/index.html" },
    { "source": "/promo-codes/:id", "destination": "/promo-codes/[id]/index.html" },
    { "source": "/promo-codes/:id/", "destination": "/promo-codes/[id]/index.html" },
    { "source": "/users/:id", "destination": "/users/[id]/index.html" },
    { "source": "/users/:id/", "destination": "/users/[id]/index.html" },
    { "source": "/pos/sales/:id", "destination": "/pos/sales/[id]/index.html" },
    { "source": "/pos/sales/:id/", "destination": "/pos/sales/[id]/index.html" }
  ]
}
