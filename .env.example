# Copy this file to .env for local development.
# Never commit real secrets.

NODE_ENV=development

# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=jersey
POSTGRES_PASSWORD=jersey
POSTGRES_DB=jersey_commerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jersey:jersey@localhost:5432/jersey_commerce?schema=public

# Redis (Docker Compose defaults)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:39217

# Auth / JWT — replace these placeholders locally. Never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32ch
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BOOTSTRAP_SECRET=
# 32+ characters. Required to save Resend/MSG91/Google secrets in Admin.
# SECRETS_ENCRYPTION_KEY=replace-with-a-long-random-secrets-key-32chars
# true only when the API is behind a reverse proxy (Caddy/nginx/Vercel) that sets X-Forwarded-For.
# With it on and the API directly exposed, clients can spoof their IP and dodge rate limits.
TRUST_PROXY=false
# 32+ characters. Encrypts backup files; required in production.
# BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-key-32chars
# Shared with the storefront so rate limits see the real shopper IP behind Vercel.
# STOREFRONT_PROXY_SECRET=replace-with-a-long-random-proxy-secret-32ch
# Optional error monitoring.
# SENTRY_DSN=

# Public API URL used by Next.js applications
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-jersey-store
# Jerzyfy is single-shop by default.
SINGLE_TENANT_MODE=true
NEXT_PUBLIC_SINGLE_TENANT=true
# Optional. Multi-shop host routing is unused in single-shop mode.
# PLATFORM_DOMAIN=platform.com
# NEXT_PUBLIC_PLATFORM_DOMAIN=platform.com

# Optional. When set, automatic backups may only be written inside this folder.
# BACKUP_ALLOWED_ROOT=C:\Backups

# Razorpay Standard Checkout (server only). Prefer Admin → Settings → Payments when set.
# Never commit real secrets. KEY_SECRET must never reach the frontend.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# Webhook secret for POST /api/v1/webhooks/razorpay (payment.captured, payment.failed, order.paid, refund.processed).
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# Unpaid online orders release stock after this many minutes (minimum 15). ORDER_EXPIRY_ENABLED=false pauses it.
# ORDER_PAYMENT_TTL_MINUTES=60
# ORDER_EXPIRY_ENABLED=true

# Storefront canonical URL (sitemap, robots, social previews)
# NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
