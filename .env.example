# Copy this file to .env for local development.
# Never commit real secrets.

NODE_ENV=development

# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=jersey
POSTGRES_PASSWORD=jersey
POSTGRES_DB=jersey_commerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jersey:jersey@localhost:5432/jersey_commerce?schema=public

# Redis (Docker Compose defaults)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Auth / JWT — replace these placeholders locally. Never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32ch
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BOOTSTRAP_SECRET=
TRUST_PROXY=false

# Public API URL used by Next.js applications
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. When set, automatic backups may only be written inside this folder.
# BACKUP_ALLOWED_ROOT=C:\Backups
